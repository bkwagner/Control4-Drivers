	<created>08/08/2026 00:00</created>
	<modified>08/08/2026 00:00</modified>
	<version>1</version>
	<control>lua_gen</control>
	<driver>DriverWorks</driver>
	<minimum_os_version>3.4.1</minimum_os_version>
	<config>
		<script file="driver.lua"></script>
		<properties>
			<property>
				<name>Device IP</name>
				<default></default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>IP address of the Google TV device. Set a DHCP reservation for it - the driver has no discovery and will not follow a changed address.</description>
			</property>
			<property>
				<name>Client Name</name>
				<default>Control4</default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>Name the TV displays for this controller while pairing. Only read during pairing.</description>
			</property>
			<property>
				<name>Pairing Code</name>
				<default></default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>After running the Pair action, type the 6-character code shown on the TV here. The field clears itself once used.</description>
			</property>
			<property>
				<name>Status</name>
				<default>Not configured</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>What the driver is currently doing.</description>
			</property>
			<property>
				<name>Paired Identity</name>
				<default>none</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>Fingerprint of the stored client certificate. Survives reboots and driver updates. Use Unpair to discard it.</description>
			</property>
			<property>
				<name>Current App</name>
				<default>unknown</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>Package name reported by the device. Only updates when the device reports a change, so it reads 'unknown' until something happens.</description>
			</property>
			<property>
				<name>Power State</name>
				<default>unknown</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>Whether the device reports itself as on. This is the streamer's own state, not the TV's.</description>
			</property>
			<property>
				<name>Device MAC</name>
				<default></default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>Used for Wake-on-LAN. Learned automatically on the first successful connection - only set this by hand if that fails. NOTE: Wake-on-LAN only works for a WIRED device. On Wi-Fi it cannot work at all, and waking depends instead on Network Standby (Settings - Network and Internet) keeping the connection alive through standby.</description>
			</property>
			<property>
				<name>Debug Mode</name>
				<type>LIST</type>
				<items>
					<item>Off</item>
					<item>Print</item>
					<item>Print and Log</item>
				</items>
				<default>Print</default>
				<readonly>false</readonly>
				<description>Diagnostic output. Print goes to the Lua window in Composer.</description>
			</property>
		</properties>
		<actions>
			<action>
				<name>Pair with Device</name>
				<command>PAIR_START</command>
			</action>
			<action>
				<name>Connect</name>
				<command>CONNECT</command>
			</action>
			<action>
				<name>Disconnect</name>
				<command>DISCONNECT</command>
			</action>
			<action>
				<name>Unpair (discard stored identity)</name>
				<command>UNPAIR</command>
			</action>
			<action>
				<name>Power On (wake)</name>
				<command>POWER_ON</command>
			</action>
			<action>
				<name>Power Off (sleep)</name>
				<command>POWER_OFF</command>
			</action>
			<action>
				<name>Send Wake-on-LAN</name>
				<command>WAKE</command>
			</action>
			<action>
				<name>Print Diagnostics</name>
				<command>DIAGNOSTICS</command>
			</action>
		</actions>
		<commands>
			<command>
				<name>Launch App</name>
				<description>Launch an app by deep link URL or package name</description>
				<params>
					<param>
						<name>App Link</name>
						<type>STRING</type>
						<default></default>
					</param>
				</params>
			</command>
			<command>
				<name>Power On</name>
				<description>Wake the device: Wake-on-LAN plus a wake key if connected</description>
			</command>
			<command>
				<name>Power Off</name>
				<description>Put the device to sleep. Does not touch TV power, which Control4 controls over CEC</description>
			</command>
			<command>
				<name>Send Key</name>
				<description>Send a raw Android key code by name, e.g. KEYCODE_SEARCH</description>
				<params>
					<param>
						<name>Key Code</name>
						<type>STRING</type>
						<default>KEYCODE_HOME</default>
					</param>
				</params>
			</command>
		</commands>
	</config>
	<proxies>
		<!--
			One proxy, everything on it - the same shape the Sony Bravia driver uses,
			with the mini-app inputs on the main proxy rather than a level down.

			A dedicated avswitch was tried first, following the SDK template and the
			Roku driver. It needs an internal AV hop from the switcher into this
			proxy, and that hop cannot be wired reliably: autobind does not fire
			(plain HDMI links, and a project full of HDMI inputs gives Composer no
			unambiguous partner), and marking it hidden takes it out of Composer
			entirely, leaving the switcher orphaned with no way to bind it.

			The template only requires the extra proxy when the main proxy does not
			receive SET_INPUT. Whether a media_player does is unverified - if it does
			not, SET_INPUT simply never arrives and the driver logs it as an
			unhandled proxy command, which is a clear signal rather than a silent
			failure.
		-->
		<proxy proxybindingid="5001" name="Google TV" primary="True">media_player</proxy>
	</proxies>
	<events/>
	<connections>
		<connection>
			<id>5001</id>
			<facing>6</facing>
			<connectionname>MEDIA_PLAYER</connectionname>
			<type>2</type>
			<consumer>False</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>MEDIA_PLAYER</classname>
				</class>
			</classes>
			<hidden>True</hidden>
		</connection>

		<!-- The device is physically plugged in here. -->
		<connection proxybindingid="5001">
			<id>2001</id>
			<type>5</type>
			<connectionname>HDMI OUT</connectionname>
			<consumer>False</consumer>
			<linelevel>True</linelevel>
			<classes>
