	<proxies>
		<proxy proxybindingid="5001" name="Google TV" primary="True">media_player</proxy>
		<!--
			The switcher carries the mini-app inputs and feeds its output into the
			media_player above, which owns the single external AV output.

			This is the hub pattern the shipping Roku driver uses, with the
			media_player as the hub rather than a third media_service proxy. The
			external output stays on the Google TV itself: that is the device
			physically plugged into the TV, it is the connection an installer expects
			to find there, and the media_player needs a path to the display of its
			own or it stops being a room source.

			Hidden in every room at init so it is not selectable as a device itself.
		-->
		<proxy proxybindingid="5999" name="Google TV Apps">avswitch</proxy>
	</proxies>
