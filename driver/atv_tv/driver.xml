	<small>devices_sm\tv.gif</small>
	<large>devices_lg\tv.gif</large>
	<minimum_os_version>3.4.1</minimum_os_version>
	<config>
		<script file="driver.lua"></script>
		<properties>
			<property>
				<name>Device Type</name>
				<type>LIST</type>
				<items>
					<item>Television</item>
					<item>Streamer</item>
				</items>
				<default>Television</default>
				<readonly>true</readonly>
				<description>Which variant this driver is. Fixed: the proxy type is declared in driver.xml and cannot change at runtime. Use the Google TV (Streamer) driver for a dongle.</description>
			</property>
			<property>
				<name>Device IP</name>
				<default></default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>IP address of the Google TV. Set a DHCP reservation for it - the driver has no discovery and will not follow a changed address.</description>
			</property>
			<property>
				<name>Client Name</name>
				<default>Control4</default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>Name the TV displays for this controller while pairing. Only read during pairing.</description>
			</property>
			<property>
				<name>Pairing Code</name>
				<default></default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>After running the Pair action, type the 6-character code shown on the TV here. The field clears itself once used.</description>
			</property>
			<property>
				<name>Status</name>
				<default>Not configured</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>What the driver is currently doing.</description>
			</property>
			<property>
				<name>Paired Identity</name>
				<default>none</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>Fingerprint of the stored client certificate. Survives reboots and driver updates. Use Unpair to discard it.</description>
			</property>
			<property>
				<name>Current App</name>
				<default>unknown</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>Package name reported by the device. Only updates when the device reports a change.</description>
			</property>
			<property>
				<name>Power State</name>
				<default>unknown</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>Whether the device reports itself as on.</description>
			</property>
			<property>
				<name>Volume Level</name>
				<default>unknown</default>
				<type>STRING</type>
				<readonly>true</readonly>
				<description>Volume as the TV reports it. Unlike a streamer, a television has its own volume, so this should track.</description>
			</property>
			<property>
				<name>Device MAC</name>
				<default></default>
				<type>STRING</type>
				<readonly>false</readonly>
				<description>Used for Wake-on-LAN. Learned automatically on the first successful connection. Wake-on-LAN only works for a WIRED device; on Wi-Fi, waking depends on Network Standby keeping the connection alive.</description>
			</property>
			<property>
				<name>Reselect Room Source</name>
				<type>LIST</type>
				<items>
					<item>Off</item>
					<item>On</item>
				</items>
				<default>Off</default>
				<readonly>false</readonly>
				<description>Off by default on a television: a tv proxy is already in the room's audio path, so the minidriver can forward key presses to it and mini-apps keep the remote working without reselecting. Only turn this On if the remote goes dead inside an app.</description>
			</property>
			<property>
				<name>Play Store Fallback</name>
				<type>LIST</type>
				<items>
					<item>On</item>
					<item>Off</item>
				</items>
				<default>On</default>
				<readonly>false</readonly>
				<description>Some apps cannot be launched directly; the device opens their Play Store page instead. With this On, the driver presses OK on that page, which launches the app. It presses repeatedly until the app opens, then stops. CAUTION: if the app is NOT installed the focused button is Install rather than Open, and this will begin an installation. Set to Off to never press.</description>
			</property>
			<property>
				<name>Debug Mode</name>
				<type>LIST</type>
				<items>
					<item>Off</item>
					<item>Print</item>
					<item>Print and Log</item>
				</items>
				<default>Print</default>
				<readonly>false</readonly>
				<description>Diagnostic output. Print goes to the Lua window in Composer.</description>
			</property>
		</properties>
		<actions>
			<action>
				<name>Pair with Device</name>
				<command>PAIR_START</command>
			</action>
			<action>
				<name>Connect</name>
				<command>CONNECT</command>
			</action>
			<action>
				<name>Disconnect</name>
