						<type>STRING</type>
						<default></default>
					</param>
				</params>
			</command>
			<command>
				<name>Send Key</name>
				<description>Send a raw Android key code by name, e.g. KEYCODE_SEARCH</description>
				<params>
					<param>
						<name>Key Code</name>
						<type>STRING</type>
						<default>KEYCODE_HOME</default>
					</param>
				</params>
			</command>
			<command>
				<name>Power On</name>
				<description>Wake the television</description>
			</command>
			<command>
				<name>Power Off</name>
				<description>Put the television to sleep</description>
			</command>
		</commands>
